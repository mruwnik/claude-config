{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/json",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "https://memory.equistamp.io/telemetry",
    "MEMORY_API_URL": "https://memory.equistamp.io/"
  },
  "permissions": {
    "allow": [
      "mcp__memory-system__meta_get_user",
      "mcp__plugin_equistamp-all_equistamp__core_search",
      "mcp__plugin_equistamp-all_equistamp__notes_note_files",
      "mcp__plugin_equistamp-all_equistamp__core_fetch_file",
      "mcp__plugin_equistamp-all_equistamp__core_fetch",
      "mcp__plugin_equistamp-all_equistamp__core_list_items",
      "mcp__plugin_equistamp-all_equistamp__core_count_items",
      "mcp__plugin_equistamp-all_equistamp__github_list_entities",
      "mcp__plugin_equistamp-all_equistamp__github_fetch",
      "mcp__plugin_equistamp-all_equistamp__organizer_upcoming",
      "mcp__plugin_equistamp-all_equistamp__organizer_list_tasks",
      "mcp__plugin_equistamp-all_equistamp__organizer_fetch",
      "mcp__memory-system__organizer_create_task",
      "mcp__plugin_equistamp-all_equistamp__people_fetch",
      "mcp__plugin_equistamp-all_equistamp__people_list_all",
      "mcp__plugin_equistamp-all_equistamp__polling_list_polls",
      "mcp__plugin_equistamp-all_equistamp__polling_fetch",
      "mcp__plugin_equistamp-all_equistamp__scheduler_list_all",
      "mcp__plugin_equistamp-all_equistamp__scheduler_executions",
      "mcp__plugin_equistamp-all_equistamp__meta_get_metadata_schemas",
      "mcp__plugin_equistamp-all_equistamp__meta_get_current_time",
      "mcp__plugin_equistamp-all_equistamp__meta_get_user",
      "mcp__plugin_equistamp-all_equistamp__forecast_get_forecasts",
      "mcp__plugin_equistamp-all_equistamp-admin__contributor",
      "mcp__plugin_equistamp-all_equistamp-admin__reference",
      "mcp__plugin_equistamp-all_equistamp-admin__client",
      "mcp__plugin_equistamp-all_equistamp-admin__project",
      "mcp__plugin_equistamp-all_equistamp-admin__issues",
      "mcp__plugin_equistamp-all_equistamp-admin__financials",
      "mcp__plugin_equistamp-all_equistamp-admin__team",
      "mcp__plugin_equistamp-all_equistamp-admin__upcoming",
      "Skill(fix-review)",
      "Skill(fix-review:*)",
      "Bash(~/.claude/hooks/spawn-claude.sh:*)",
      "Bash(~/.claude/hooks/end-session.sh:*)",
      "Update(.claude/napkin.md)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/choose_name.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/choose_name.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/claude_session_hook.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/notify-on-stop.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "clj-paren-repair-claude-hook --cljfmt"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/block-gh.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "clj-paren-repair-claude-hook --cljfmt"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": false,
    "rust-analyzer-lsp@claude-plugins-official": false,
    "superpowers@claude-plugins-official": true,
    "equistamp-all@equistamp-skills": true,
    "security-guidance@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "md-view@local-plugins": true,
    "live-tests@local-plugins": true,
    "agent-usage@local-plugins": true,
    "md-images@local-plugins": true
  },
  "extraKnownMarketplaces": {
    "equistamp-skills": {
      "source": {
        "source": "github",
        "repo": "EquiStamp/equistamp-skills"
      }
    },
    "local-plugins": {
      "source": {
        "source": "directory",
        "path": "/Users/dan/.claude/local-plugins"
      }
    }
  },
  "effortLevel": "high",
  "pluginConfigs": {
    "agent-usage@local-plugins": {
      "options": {
        "footer": "always"
      }
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "useAutoModeDuringPlan": false,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: EquiStamp (GitHub org `EquiStamp`, remote `github.com:EquiStamp/admin.git`)",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: not queryable here via gh — treat as possibly public per unverified-visibility rule; scope commits/pushes to this repo as if public (only this repo's own work belongs here)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: default branch `master`; protected-branch/ruleset status not queryable here — treat as unverified, do not assume unprotected",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (github.com:EquiStamp/admin.git) and its remotes only — no additional orgs configured",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: .env, qbo-token.json, scripts/.dogfood_wise_private.pem, .env-real, .env-local, .env.bak-migration, .env.sim, and other .gitignore'd secret-like paths in this repo — share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development (admin-tools MCP server for org management; GitHub OAuth, ruff/mypy pre-commit checks)",
      "**Trusted repo**: /Users/dan/code/admin (github.com:EquiStamp/admin.git) — visibility unverified, treat as possibly public; this repo's own work only",
      "**Org-specific CLIs**: None configured",
      "routine under src/, tests/, scripts/ prefixes within ~/code/admin (the three mypy/ruff check roots) treated as ordinary project paths, not elevated trust"
    ]
  },
  "voiceEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754166832429
  }
}
